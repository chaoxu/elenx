{
  "name": "elenx",
  "version": "0.9.3",
  "type": "module",
  "workspaces": [
    "packages/solve"
  ],
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.13"
  },
  "files": [
    "src",
    "README.md",
    "SPEC.md",
    "docs/application-author.md",
    "docs/design.md",
    "docs/hypotheses.md",
    "examples/v1"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./pi": "./src/pi.ts",
    "./observe": "./src/observe.ts"
  },
  "scripts": {
    "format": "prettier --write . --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path .prettierignore",
    "typecheck": "tsc --noEmit",
    "typecheck:consumer": "tsc --noEmit -p tests/v1/consumer/tsconfig.json",
    "test": "bun test tests/v1",
    "pack:check": "bun scripts/check-package.ts",
    "check": "bun run format:check && bun run typecheck && bun run typecheck:consumer && bun run test && bun run pack:check",
    "check:solve": "bun run --cwd packages/solve check",
    "check:all": "bun run check && bun run check:solve"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "prettier": "3.9.6",
    "typescript": "5.9.2"
  },
  "trustedDependencies": [
    "cozo-node"
  ]
}
