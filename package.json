{
  "name": "elenx",
  "version": "0.7.11",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.13"
  },
  "files": [
    "src",
    "README.md",
    "SPEC.md",
    "docs/application-author.md",
    "examples/v1"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./pi": "./src/pi.ts"
  },
  "scripts": {
    "format": "prettier --write . --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path .prettierignore",
    "typecheck": "tsc --noEmit",
    "typecheck:consumer": "tsc --noEmit -p tests/v1/consumer/tsconfig.json",
    "test": "bun test",
    "pack:check": "bun scripts/check-package.ts",
    "check": "bun run format:check && bun run typecheck && bun run typecheck:consumer && bun run test && bun run pack:check"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "prettier": "3.9.6",
    "typescript": "5.9.2"
  }
}
