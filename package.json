{
  "name": "elenx",
  "version": "0.4.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "files": [
    "src",
    "README.md",
    "SPEC.md",
    "docs",
    "examples/v1"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./pi": "./src/pi.ts"
  },
  "scripts": {
    "format": "prettier --write . --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path .prettierignore",
    "typecheck": "tsc --noEmit",
    "typecheck:consumer": "tsc --noEmit -p tests/v1/consumer/tsconfig.json",
    "check:size": "bun scripts/check-size.ts",
    "test": "bun test",
    "check": "bun run format:check && bun run typecheck && bun run typecheck:consumer && bun run check:size && bun run test"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-telemetry": "0.84.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@types/bun": "1.3.14",
    "prettier": "3.9.6",
    "typescript": "5.9.2"
  }
}
