{
  "name": "elenx-solve",
  "version": "0.34.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.13"
  },
  "bin": {
    "elenx-solve": "./solve.ts"
  },
  "exports": {
    ".": "./solve.ts"
  },
  "files": [
    "*.ts",
    "verifiers",
    "README.md",
    "docs",
    "examples"
  ],
  "scripts": {
    "format": "prettier --write . --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path .prettierignore",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "call-surface:update": "bun scripts/update-call-surface.ts",
    "pack:check": "bun scripts/check-package.ts",
    "check": "bun run format:check && bun run typecheck && bun run test && bun run pack:check && bun solve.ts --help"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "elenx": "^0.9.3"
  },
  "peerDependenciesMeta": {
    "elenx": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "elenx": "file:../..",
    "prettier": "3.9.6",
    "typescript": "5.9.2"
  }
}
